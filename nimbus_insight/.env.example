# ── AI Provider Priority: OpenAI → Anthropic → Ollama ──────────────────────
# The script tries each provider in order, falling through on failure.

# 1. OpenAI (primary — set this to use GPT-4o-mini by default)
#    Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_VALID_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# 2. Anthropic Claude (fallback — optional)
#    Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 3. Ollama local model (last resort — set USE_OLLAMA=true to enable)
#    Requires Ollama running at OLLAMA_BASE_URL
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# App
LOG_LEVEL=info
